{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": null,
  "buildCommand": "npm run vercel-build",
  "outputDirectory": "public",
  "functions": {
    "api/*.js": {
      "maxDuration": 60,
      "includeFiles": "api/bin/**"
    },
    "api/*/*.js": {
      "maxDuration": 60,
      "includeFiles": "api/bin/**"
    }
  },
  "rewrites": [
    {
      "source": "/api/health",
      "destination": "/api/meta?p=health"
    },
    {
      "source": "/api/config",
      "destination": "/api/meta?p=config"
    },
    {
      "source": "/api/env.js",
      "destination": "/api/meta?p=env"
    },
    {
      "source": "/api/cookies-health",
      "destination": "/api/meta?p=cookies"
    },
    {
      "source": "/api/stats",
      "destination": "/api/admin?p=stats"
    },
    {
      "source": "/api/client-log",
      "destination": "/api/admin?p=client-log"
    },
    {
      "source": "/api/mp3",
      "destination": "/api/convert?p=mp3"
    },
    {
      "source": "/api/merge",
      "destination": "/api/convert?p=merge"
    },
    {
      "source": "/api/admin/cookies",
      "destination": "/api/admin?p=cookies"
    },
    {
      "source": "/api/ytvideo",
      "destination": "/api/index"
    }
  ],
  "headers": [
    {
      "source": "/manifest.webmanifest",
      "headers": [
        { "key": "Content-Type", "value": "application/manifest+json; charset=utf-8" },
        { "key": "Cache-Control", "value": "public, max-age=0, must-revalidate" }
      ]
    },
    {
      "source": "/sw.js",
      "headers": [
        { "key": "Service-Worker-Allowed", "value": "/" },
        { "key": "Cache-Control", "value": "no-cache, no-store, must-revalidate" }
      ]
    }
  ]
}
